
# Corporate Automation Lab
# Example environment configuration for local development.
#
# Copy this file to .env and configure your own credentials.
# Never commit the .env file or share real credentials.

# SQL Server 2022
# Use a strong password that meets SQL Server complexity requirements.
MSSQL_SA_PASSWORD=

# JWT authentication
# Generate a cryptographically random 32-byte key encoded as Base64.
JWT_KEY=

# Development-only token generation
# Use a separate, strong random credential.
DEV_TOKEN_PASSWORD=
